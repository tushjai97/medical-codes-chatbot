# Database Configuration
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DB_POOL_SIZE=20

# LLM API Configuration
PERPLEXITY_API_KEY=pplx-your_api_key_here
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online

# Embedding Model Configuration
VOYAGE_API_KEY=pa-your_voyage_api_key_here
VOYAGE_MODEL_NAME=voyage-4-lite
EMBEDDING_DIM=1024

# Application Configuration
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Performance Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=medical-coding-rag
