# Database Configuration
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DB_POOL_SIZE=20

# Embedding Model Configuration
VOYAGE_API_KEY=pa-your_voyage_api_key_here
VOYAGE_MODEL_NAME=voyage-4-lite
EMBEDDING_DIM=1024

# Reranker (Expert mode) -- local open-source cross-encoder, no API key needed
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Application Configuration
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Performance Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=medical-coding-rag
